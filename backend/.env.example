GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GEMINI_API_KEY=your_gemini_api_key
# Optional: Gemini model id (default gemini-3.8-flash, keep in sync with src/shared/lib/geminiClient.ts)
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared secret for server-to-server calls (Next.js sends it as X-Internal-Secret header).
# REQUIRED in production (service returns 503 if unset). Generate: openssl rand -hex 32
INTERNAL_API_SECRET=your_long_random_secret
# Optional: comma-separated browser origins allowed by CORS (default http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
# Set to "production" to hide /docs and fail closed (auto-detected on Railway)
ENVIRONMENT=production
# Optional alias for ENVIRONMENT; RAILWAY_ENVIRONMENT is set automatically by Railway
APP_ENV=
RAILWAY_ENVIRONMENT=
# Optional Naver Search API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
