GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GEMINI_API_KEY=your_gemini_api_key
# Optional: Gemini model id (default gemini-3.8-flash, keep in sync with src/shared/lib/geminiClient.ts)
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared secret for server-to-server calls (Next.js sends it as X-Internal-Secret header).
# REQUIRED: service returns 503 on protected endpoints if unset. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=your_long_random_secret
# Local dev ONLY: set to 1 to allow running without INTERNAL_API_SECRET (also enables /docs). Never set in production.
# ALLOW_INSECURE_DEV=1
# Server-to-server only (Vercel -> Render), so CORS is not needed. Optional: comma-separated browser origins (default: none)
CORS_ORIGINS=
# /docs, /redoc are exposed only when ENVIRONMENT=development (or ALLOW_INSECURE_DEV=1); otherwise disabled
ENVIRONMENT=production
# Optional Naver Search API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
